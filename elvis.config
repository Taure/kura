[
    {config, [
        #{
            files => ["src/*.erl"],
            ruleset => erl_files,
            rules => [
                %% kura dispatches to the configured dialect, driver, keyring
                %% and {custom, Mod} type modules by design - that is what the
                %% behaviours are for.
                {elvis_style, no_invalid_dynamic_calls, disable},
                %% A data layer's public surface is wide on purpose.
                {elvis_style, no_god_modules, disable},
                %% Fires on sibling clauses that differ only in the SQL they
                %% emit, which is the clearest way to write a dialect.
                {elvis_style, dont_repeat_yourself, disable},
                %% erlfmt owns layout and runs in CI with --check.
                {elvis_text_style, max_line_length, disable},
                %% kura's public specs are written in terms of #kura_query{},
                %% #kura_changeset{} and friends; that is the API.
                {elvis_style, no_spec_with_records, disable},
                {elvis_style, private_data_types, disable},
                %% Would mean rewriting every function head in the library.
                {elvis_style, param_pattern_matching, disable},
                %% throw/1 is local control flow: every one is a
                %% {kura_rollback, _} or {multi_error, _} caught in the same
                %% module to abort a transaction fun.
                {elvis_style, no_throw, disable},
                %% Record fields come from consumer-written schemas, so
                %% comparing to true/false is a type check, not redundancy.
                {elvis_style, no_boolean_in_comparison, disable},
                %% begin...end inside a list comprehension is how a
                %% multi-statement comprehension is spelled.
                {elvis_style, no_block_expressions, disable},
                {elvis_style, no_deep_nesting, #{level => 6}}
            ]
        }
    ]}
].
