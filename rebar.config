{erl_opts, [debug_info, warnings_as_errors]}.

{deps, [
    {telemetry, "~> 1.0"}
]}.

{project_plugins, [
    erlfmt,
    {rebar3_hex, "~> 7.5"},
    rebar3_ex_doc,
    rebar3_lint,
    rebar3_hank,
    rebar3_sheldon,
    {rebar3_mutate, "~> 0.6.1"},
    covertool,
    {rebar3_audit, "~> 0.2"}
]}.

{erlfmt, [write]}.

{mutate, [
    {eunit_tests, #{
        kura_app => [kura_db_start_pool_tests],
        kura_capabilities => [kura_capabilities_query_tests],
        kura_changeset => [kura_nested_cast_tests],
        kura_changeset_assoc => [
            kura_nested_cast_tests,
            kura_cast_assoc_tests,
            kura_changeset_assoc_edge_tests,
            kura_many_to_many_tests
        ],
        kura_db => [
            kura_tokenizer_prop_tests,
            kura_statement_facts_tests,
            kura_telemetry_tests,
            kura_redact_tests,
            kura_db_start_pool_tests,
            kura_db_pool_module_tests,
            kura_integration_tests,
            kura_integration_assoc_tests,
            kura_sandbox_tests,
            kura_sandbox_ended_tests,
            kura_migrator_nontx_tests,
            kura_encryption_seam_tests,
            kura_encryption_v2_integration_tests
        ],
        kura_crypto => [
            kura_crypto_det_tests,
            kura_crypto_det_prop_tests,
            kura_crypto_v2_tests,
            kura_crypto_v2_prop_tests,
            kura_crypto_v2_corpus_tests,
            kura_crypto_v1_corpus_tests,
            kura_encryption_seam_tests
        ],
        kura_dialect => [
            kura_dialect_pg_tests,
            kura_db_pool_module_tests,
            kura_migrator_tests,
            kura_types_tests
        ],
        kura_dialect_pg => [
            kura_query_tests,
            kura_query_compiler_tests,
            kura_column_mapping_tests,
            kura_tokenizer_prop_tests
        ],
        kura_hkdf => [kura_crypto_v2_tests],
        kura_keyring_env => [kura_crypto_det_tests],
        kura_migrator => [kura_migrator_nontx_tests],
        kura_paginator => [kura_paginator_edge_tests],
        kura_repo => [kura_db_start_pool_tests],
        kura_repo_settings => [kura_db_start_pool_tests, kura_require_tenant_tests],
        kura_preloader => [
            kura_integration_assoc_tests,
            kura_conditional_preload_tests,
            kura_sandbox_tests,
            kura_tenant_integration_tests
        ],
        kura_query => [
            kura_encryption_lookup_tests,
            kura_encrypted_guard_tests,
            kura_query_compiler_tests,
            kura_dialect_pg_tests,
            kura_query_shape_tests,
            kura_query_sources_tests,
            kura_tokenizer_prop_tests
        ],
        kura_query_compiler => [
            kura_encrypted_guard_tests,
            kura_query_shape_tests,
            kura_statement_facts_tests,
            kura_capabilities_query_tests,
            kura_require_tenant_tests
        ],
        kura_query_shape => [kura_encrypted_guard_tests, kura_encryption_lookup_tests],
        kura_encryption => [kura_encryption_lookup_tests, kura_encryption_det_schema_tests],
        kura_redact => [
            kura_redact_prop_tests,
            kura_statement_facts_tests,
            kura_schema_load_plan_tests
        ],
        kura_repo_worker => [
            kura_repo_worker_statement_tests,
            kura_statement_facts_tests,
            kura_require_tenant_tests,
            kura_redact_tests,
            kura_constraint_field_tests,
            kura_timestamps_tests,
            kura_db_start_pool_tests,
            kura_integration_tests,
            kura_integration_assoc_tests,
            kura_tenant_integration_tests,
            kura_encrypted_guard_tests,
            kura_encryption_seam_tests,
            kura_encryption_v2_integration_tests
        ],
        kura_sandbox => [kura_sandbox_edge_tests, kura_sandbox_ended_tests],
        kura_query_cache => [kura_query_compiler_tests, kura_query_shape_tests, kura_schema_tests],
        kura_schema => [
            kura_encrypted_guard_tests,
            kura_encrypted_schema_tests,
            kura_encryption_seam_tests,
            kura_encryption_det_schema_tests,
            kura_schema_load_plan_tests,
            kura_timestamps_tests,
            kura_column_mapping_tests
        ],
        kura_stream => [kura_integration_tests, kura_capabilities_query_tests, kura_redact_tests],
        kura_tenant => [kura_encrypted_guard_tests, kura_require_tenant_tests],
        kura_types => [
            kura_encryption_det_schema_tests,
            kura_crypto_det_prop_tests,
            kura_encrypted_schema_tests,
            kura_encryption_seam_tests,
            kura_crypto_v1_corpus_tests,
            kura_crypto_v2_corpus_tests,
            kura_crypto_v2_prop_tests
        ]
    }}
]}.

{hank, [
    {ignore, [
        {"test/**", [unnecessary_function_arguments]},
        {"src/kura_dialect.erl", [unused_callbacks]},
        {"src/kura_driver.erl", [unused_callbacks]},
        {"src/kura_keyring.erl", [unused_callbacks]},
        {"src/kura_migration.erl", [unused_callbacks]},
        {"src/kura_pool.erl", [unused_callbacks]},
        {"src/kura_repo.erl", [unused_callbacks]},
        {"src/kura_schema.erl", [unused_callbacks]},
        {"src/kura_type.erl", [unused_callbacks]}
    ]}
]}.

{spellcheck, [
    {files, ["src/**/*.erl", "include/**/*.hrl"]},
    {ignore, [
        "src/kura_query_compiler.erl",
        "src/kura_preloader.erl",
        "src/kura_types.erl",
        "src/kura_changeset.erl",
        "src/kura_repo_worker.erl"
    ]},
    {ignore_regex, "[_@./#&+-=%*~$]"}
]}.

{cover_enabled, true}.
{cover_export_enabled, true}.
{covertool, [{coverdata_files, ["eunit.coverdata", "ct.coverdata"]}]}.

{eunit_opts, [
    {exclude_modules, [kura_stream_bench]}
]}.

{profiles, [
    {test, [
        {deps, [
            {minato, "~> 1.0"},
            {proper, "~> 1.4"}
        ]}
    ]},
    {eqwalizer, [
        {deps, [
            {eqwalizer_support,
                {git_subdir, "https://github.com/WhatsApp/erlang-language-platform.git",
                    {tag, "2026-08-07"}, "eqwalizer/eqwalizer_support"}}
        ]}
    ]}
]}.

{xref_checks, [
    undefined_function_calls,
    undefined_functions,
    locals_not_used,
    deprecated_function_calls,
    deprecated_functions
]}.

{dialyzer, [
    {warnings, [
        error_handling,
        unmatched_returns
    ]}
]}.

{hex, [
    {doc, #{provider => ex_doc}},
    {include_files, [
        <<"src">>,
        <<"include">>,
        <<"priv">>,
        <<"rebar.config">>,
        <<"rebar.lock">>,
        <<"README.md">>,
        <<"CHANGELOG.md">>,
        <<"MIGRATION-2.0.md">>,
        <<"SECURITY.md">>,
        <<"LICENSE">>,
        <<"guides">>
    ]}
]}.

{ex_doc, [
    {source_url, <<"https://github.com/Taure/kura">>},
    {logo, <<"priv/kura.png">>},
    {skip_undefined_reference_warnings_on, [<<"CHANGELOG.md">>]},
    {extras, [
        <<"README.md">>,
        <<"CHANGELOG.md">>,
        <<"guides/upgrading.md">>,
        <<"MIGRATION-2.0.md">>,
        <<"SECURITY.md">>,
        <<"guides/getting-started.md">>,
        <<"guides/changesets.md">>,
        <<"guides/schemaless-changesets.md">>,
        <<"guides/constraints-and-indexes.md">>,
        <<"guides/query-builder.md">>,
        <<"guides/associations.md">>,
        <<"guides/cast_assoc.md">>,
        <<"guides/embedded-schemas.md">>,
        <<"guides/multi.md">>,
        <<"guides/migrations.md">>,
        <<"guides/rolling_deployments.md">>,
        <<"guides/enums.md">>,
        <<"guides/telemetry.md">>,
        <<"guides/lifecycle-hooks.md">>,
        <<"guides/audit-trail.md">>,
        <<"guides/pagination.md">>,
        <<"guides/streaming.md">>,
        <<"guides/multitenancy.md">>,
        <<"guides/optimistic-locking.md">>,
        <<"guides/testing.md">>,
        <<"guides/architecture.md">>,
        <<"LICENSE">>
    ]},
    {groups_for_extras, [
        {<<"Getting Started">>, [
            <<"guides/getting-started.md">>
        ]},
        {<<"Guides">>, [
            <<"guides/changesets.md">>,
            <<"guides/schemaless-changesets.md">>,
            <<"guides/constraints-and-indexes.md">>,
            <<"guides/query-builder.md">>,
            <<"guides/associations.md">>,
            <<"guides/cast_assoc.md">>,
            <<"guides/embedded-schemas.md">>,
            <<"guides/multi.md">>,
            <<"guides/migrations.md">>,
            <<"guides/rolling_deployments.md">>,
            <<"guides/enums.md">>,
            <<"guides/telemetry.md">>,
            <<"guides/lifecycle-hooks.md">>,
            <<"guides/audit-trail.md">>,
            <<"guides/pagination.md">>,
            <<"guides/streaming.md">>,
            <<"guides/multitenancy.md">>,
            <<"guides/optimistic-locking.md">>,
            <<"guides/testing.md">>
        ]},
        {<<"Reference">>, [
            <<"guides/architecture.md">>,
            <<"CHANGELOG.md">>,
            <<"guides/upgrading.md">>,
            <<"MIGRATION-2.0.md">>
        ]}
    ]},
    {groups_for_modules, [
        {<<"Core">>, [kura_schema, kura_changeset, kura_query, kura_repo, kura_repo_worker]},
        {<<"Features">>, [
            kura_multi,
            kura_types,
            kura_encryption,
            kura_migration,
            kura_migrator,
            kura_audit,
            kura_audit_log,
            kura_paginator,
            kura_stream,
            kura_tenant,
            kura_redact,
            kura_sandbox
        ]},
        {<<"Internal">>, [kura_query_compiler]}
    ]},
    {main, <<"README.md">>},
    {homepage_url, <<"https://github.com/Taure/kura">>},
    {api_reference, true}
]}.
